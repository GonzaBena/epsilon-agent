# .env.example
TELEGRAM_TOKEN=
ALLOWED_USER_ID=
DATA_DIR=~/epsilon-data
# Se saca en https://aistudio.google.com/ (sin ella, todo anda menos lo que usa IA)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Opcional: puerto de la web local (por defecto 8765)
# WEB_PORT=8765
# Opcional: voz (micrófono de la web y notas de voz de Telegram). Por defecto, sí.
# VOICE_ENABLED=si
# Opcional: que Telegram pregunte antes de ejecutar una nota de voz. Por defecto, no.
# VOICE_CONFIRM=no
# Opcional: cómo le hablás a Epsilon por voz. «Hola Meli, ¿qué tengo hoy?» equivale a «/ia ¿qué tengo hoy?».
# Varios nombres separados por coma (la voz a veces escribe distinto). Siempre en minúsculas y sin tilde. Por defecto: ia, ai
# ASSISTANT_NAME=meli
# Opcional: cómo te llama Epsilon y cómo lo llamás vos (también se cambian en Configuración).
# USER_NAME=Ana
# AGENT_NAME=Epsilon
