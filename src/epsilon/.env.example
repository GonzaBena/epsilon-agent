# .env.example
TELEGRAM_TOKEN=
ALLOWED_USER_ID=
DATA_DIR=~/epsilon-data
GEMINI_API_KEY=tu_clave_aca
GEMINI_MODEL=gemini-3.1-flash-lite
# Opcional: puerto de la web local (por defecto 8765)
# WEB_PORT=8765
# Opcional: voz (micrófono de la web y notas de voz de Telegram). Por defecto, sí.
# VOICE_ENABLED=si
# Opcional: que Telegram pregunte antes de ejecutar una nota de voz. Por defecto, no.
# VOICE_CONFIRM=no
