# .env.example: acá van solo las claves y lo que se lee antes que todo lo demás.
# Lo demás (tu nombre en USER_NAME, el del asistente en AGENT_NAME, el modelo, la voz, el navegador...)
# va en DATA_DIR/settings.json, que también se edita desde Configuración. Si dejás esos ajustes acá,
# Epsilon los pasa a settings.json la primera vez que arranca.
TELEGRAM_TOKEN=
ALLOWED_USER_ID=
DATA_DIR=~/epsilon-data
# Se saca en https://aistudio.google.com/ (sin ella, todo anda menos lo que usa IA)
GEMINI_API_KEY=
# Opcional: clave de Anthropic (https://console.anthropic.com/); el modelo se elige como anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=
